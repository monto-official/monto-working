NEXT_PUBLIC_API_URL=https://backend-gamma-ashen-81.vercel.app

# ── TURN (NAT traversal for calls across different networks) ─────────────────
# Free public test server (Open Relay Project / metered.ca) — no signup,
# best-effort/rate-limited but fine for testing. Embedded into the pairing QR
# code this app generates (see PairingQRModal.tsx), so the parent app inherits
# these via the redeemed pairing data — it doesn't need its own copy. Without
# this, calls only work when both sides are on networks with permissive NAT;
# TURN is what makes it work between two arbitrary/different networks.
NEXT_PUBLIC_TURN_URL=turns:global.relay.metered.ca:443?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=openrelayproject
NEXT_PUBLIC_TURN_PASSWORD=openrelayproject
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA2F59EX6epsD1TCD3xkZpBQfgoJycvevU
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://monto-ccy66-default-rtdb.firebaseio.com
