[Unit]
Description=Monto AI Web Frontend (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/monto-working/frontend
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
