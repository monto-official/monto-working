# Local dev: point straight at the local backend, no tunnel involved.
# (Switched back from a Cloudflare quick tunnel because this ISP's DNS
# resolver was unreliable for trycloudflare.com subdomains, causing
# spurious OFFLINE status even when the tunnel and backend were healthy.)
# For phone/external-network pairing testing, run
# monto-ai/scripts/cloudflared-watchdog.ps1 separately and swap this back
# to the tunnel URL it prints.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: Picovoice Porcupine for noise-robust wake word detection
# Get free key at https://console.picovoice.ai, train "Hey Monto" keyword
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=

# ── TURN (NAT/AP-isolation relay for calls) ───────────────────────────────────
# Free public test server (Open Relay Project / metered.ca) — no signup, but
# best-effort/rate-limited, fine for testing. Swap for self-hosted coturn
# (see docker-compose.yml) for production. Embedded into the pairing QR code
# this app generates, so re-pair the parent app after changing this.
# TLS-over-443 transport — looks like ordinary HTTPS traffic to any firewall,
# so it gets through even networks that block plain UDP/TCP TURN (campus/
# office wifi with strict egress rules). Plain turn:...:80 (UDP) was tried
# first and still failed, which pointed at exactly this.
NEXT_PUBLIC_TURN_URL=turns:global.relay.metered.ca:443?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=openrelayproject
NEXT_PUBLIC_TURN_PASSWORD=openrelayproject
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA2F59EX6epsD1TCD3xkZpBQfgoJycvevU
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://monto-ccy66-default-rtdb.firebaseio.com
