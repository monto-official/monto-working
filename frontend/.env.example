NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: Picovoice Porcupine for noise-robust wake word detection
# Get free key at https://console.picovoice.ai, train "Hey Monto" keyword
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=

# ── Calling: TURN server (NAT traversal across different networks) ───────────
# Must match the coturn service's TURN_USERNAME/TURN_PASSWORD in the root .env
NEXT_PUBLIC_TURN_URL=turn:localhost:3478
NEXT_PUBLIC_TURN_USERNAME=montoturn
NEXT_PUBLIC_TURN_PASSWORD=montoturnpass123

# ── Calling: pairing/sync ID ───────────────────────────────────────────────────
# Must match parent-app's NEXT_PUBLIC_DEVICE_ID (and root .env MONTO_DEVICE_ID)
# so this device's calls reach the right parent app.
NEXT_PUBLIC_DEVICE_ID=monto-room

NEXT_PUBLIC_SIGNALING_URL=wss://monto-signaling-production.up.railway.app/ws/call
# Firebase Realtime Database signaling (WebRTC media remains peer-to-peer)
# Enable Anonymous sign-in in Firebase Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com